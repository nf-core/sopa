params {
  read = [
    technology: 'cosmx'
  ]
  patchify = [
    patch_width_pixel: 6000,
    patch_overlap_pixel: 150,
  ]
  segmentation = [
    cellpose: [
      diameter: 60,
      channels: [
        'DNA'
      ],
      flow_threshold: 2,
      cellprob_threshold: -6,
      min_area: 2000,
    ]
  ]
  aggregate = [
    aggregate_channels: true,
    min_transcripts: 10,
  ]
  explorer = [
    ram_threshold_gb: 4
  ]
}
