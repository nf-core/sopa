params {
  read = [
    technology: 'xenium'
  ]
  patchify = [
    patch_width_pixel: 6000,
    patch_overlap_pixel: 150,
  ]
  segmentation = [
    cellpose: [
      diameter: 30,
      channels: [
        'DAPI'
      ],
      flow_threshold: 2,
      cellprob_threshold: -6,
      min_area: 400,
    ]
  ]
  aggregate = [
    aggregate_channels: true,
    min_transcripts: 10,
  ]
  explorer = [
    ram_threshold_gb: 4
  ]
}
