params {
  // Reader
  technology = 'cosmx'

  // Patches
  patch_width_microns = 8000
  patch_overlap_microns = 150

  // Filtering
  min_transcripts = 10
  min_area_microns2 = 20

  // Baysor
  use_baysor = true
  baysor_scale = 6.25
  min_molecules_per_cell = 10
  min_molecules_per_gene = 0
  min_molecules_per_segment = 3
  confidence_nn_id = 6
  prior_segmentation_confidence = 0

  // Aggregation
  aggregate_channels = true
}
