params {
  read = [
    technology: 'visium_hd'
  ]
  patchify = [
    patch_width_pixel: 2000,
    patch_overlap_pixel: 50,
  ]
  segmentation = [
    stardist: [
      min_area: 30
    ]
  ]
  aggregate = [
    aggregate_channels: true,
    min_transcripts: 10,
  ]
  explorer = [
    ram_threshold_gb: 4
  ]
}
