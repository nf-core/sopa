nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    profile "test_baysor"
    tag "pipeline"

    test("-profile test_baysor") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_sopa_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )

            // ensure we have >=1500 non-zero genes over >=350 cells
            def json_X = new groovy.json.JsonSlurper().parse(file("$outputDir/sample_name.zarr/tables/table/X/zarr.json"))
            def nCells = json_X.attributes.shape[0] as int
            assert nCells >= 350

            def json_data = new groovy.json.JsonSlurper().parse(file("$outputDir/sample_name.zarr/tables/table/X/data/zarr.json"))
            def nElements = json_data.shape[0] as int
            assert nElements >= 1500
        }
    }
}
